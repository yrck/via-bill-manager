FROM php:8.4-fpm-bookworm AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev libzip-dev libicu-dev unzip \
    && docker-php-ext-install pdo_pgsql intl zip pcntl opcache \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /var/www/html
ENV COMPOSER_ALLOW_SUPERUSER=1

FROM runtime AS dependencies
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-scripts --no-autoloader

FROM node:22-bookworm-slim AS assets
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY --from=dependencies /var/www/html/vendor ./vendor
COPY resources ./resources
COPY vite.config.js ./
RUN npm run build

FROM runtime AS app
COPY . .
COPY --from=dependencies /var/www/html/vendor ./vendor
COPY --from=assets /build/public/build ./public/build
RUN composer dump-autoload --no-dev --optimize \
    && mkdir -p storage/app/private storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache
USER www-data
CMD ["php-fpm"]

FROM nginx:1.28-alpine AS web
COPY public /var/www/html/public
COPY --from=assets /build/public/build /var/www/html/public/build
COPY docker/nginx.coolify.conf /etc/nginx/conf.d/default.conf
